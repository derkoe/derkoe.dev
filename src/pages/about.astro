---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import derkoeSquare from "../assets/derkoe-square.jpg";
import { socialLinks } from "../config";
---

<Layout title="About Me - Christian Köberl">
  <div class="about-container">
    <Image
      src={derkoeSquare}
      alt="Christian Köberl laughing"
      class="about-image"
      width={500}
      height={500}
    />

    <div class="about-content">
      <h1>About Me</h1>
      <p>
        Hi, I'm Christian Köberl, a passionate software developer with &gt; 25
        years of experience in building web applications and distributed
        systems.
      </p>

      <h2>My Journey</h2>
      <p>
        I've been working in software development for many years, focusing on
        creating efficient and scalable solutions. I'm particularly interested
        in cloud technologies, DevOps practices, and modern web development.
      </p>

      <h2>Skills & Expertise</h2>
      <ul>
        <li>Full-stack Web Development</li>
        <li>Cloud Technologies</li>
        <li>DevOps & CI/CD</li>
        <li>Software Architecture</li>
      </ul>

      <h2>Get in Touch</h2>
      <p>
        Feel free to reach out to me through my social media profiles or via
        email:
        <ul class="social-links">
          {
            socialLinks.map(link => (
              <li>
                <a href={link.url} target="_blank" rel="noopener noreferrer">
                  <span>{link.name}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </p>
      <h1>About This Site</h1>
      <p>
        This site was built with <a
          href="https://astro.build"
          target="_blank"
          rel="noopener noreferrer">Astro</a
        > - thanks for the amazing framework!
      </p>
      <p>
        Thanks to <a
          href="https://www.headshots.at/"
          target="_blank"
          rel="noopener">Amir Kaljikovic</a
        > for the nice headshots of me!
      </p>
      <h1>Imprint</h1>
      <p>Owner: Chrisitan Köberl, 5310 Tiefgraben, Austria</p>
    </div>
  </div>
</Layout>

<style>
  .about-container {
    margin: 0 auto;
  }

  .about-image {
    display: block;
    width: 300px;
    height: 300px;
    border-radius: 50%;
    margin: 0 auto 3rem auto;
    box-shadow: var(--shadow-lg);
  }

  .about-content {
    background: var(--background-body);
    padding: 2.5rem;
    border-radius: 1rem;
    border: 1px solid var(--border);
    box-shadow: var(--shadow-sm);
  }

  h1 {
    font-size: 2.5rem;
    font-weight: 800;
    color: var(--accent);
    margin-top: 0;
    margin-bottom: 1.5rem;
    letter-spacing: -0.025em;
  }

  h2 {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--accent);
    margin-top: 2.5rem;
    margin-bottom: 1rem;
  }

  li {
    padding: 0.4rem 0;
    line-height: 1.6;
  }

  li:last-child {
    border-bottom: none;
  }

  p {
    line-height: 1.6;
    color: var(--text);
  }

  a {
    color: var(--accent);
    text-decoration: none;
    transition: color 0.2s ease;
    font-weight: 500;
  }

  a:hover {
    color: var(--accent-hover);
    text-decoration: underline;
  }
</style>
