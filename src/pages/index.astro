---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";
import derkoeLaughing from "../assets/derkoe-laughing.jpg";
import { Image } from "astro:assets";

const posts = await getCollection("blog");
posts.sort((a, b) => b.data.pubDate?.valueOf() - a.data.pubDate?.valueOf());
---

<Layout>
  <div class="hero">
    <div class="hero-text">
      <h1>Hi, I'm Kö!</h1>
      <p>
        My name is Christian Köberl and I am a software engineer @ Porsche
        Informatik in Salzburg, Austria.
      </p>
    </div>
    <div class="hero-content">
      <Image
        src={derkoeLaughing}
        alt="Christian Köberl laughing"
        class="profile-image"
        width={400}
        height={600}
      />
      <div class="nav-cards">
        <a href="/blog" class="nav-card">
          <h2>Blog</h2>
          <p>
            Read my thoughts and experiences about software development, cloud
            computing, and more.
          </p>
          <span class="card-arrow">→</span>
        </a>
        <a href="/talks" class="nav-card">
          <h2>Talks</h2>
          <p>
            Watch my conference talks and presentations about various tech
            topics.
          </p>
          <span class="card-arrow">→</span>
        </a>
      </div>
    </div>
  </div>

  <section class="blog-preview">
    <h2>Latest Blog Posts</h2>
    <div class="post-grid">
      {
        posts.map(post => (
          <a
            href={`/blog/${post.id.replace(/\.mdx?$/, "").toLowerCase()}`}
            class="post-card"
          >
            <article>
              <h3>{post.data.title}</h3>
              <p>{post.data.summary}</p>
              <span class="read-more">Read more →</span>
            </article>
          </a>
        ))
      }
    </div>
  </section>
</Layout>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    margin-bottom: 4rem;
  }

  .hero-text {
    text-align: center;
    padding: 2rem 0;
  }

  .hero-content {
    display: flex;
    flex-direction: column;
  }

  @media (min-width: 768px) {
    .hero-content {
      flex-direction: row-reverse;
      gap: 3rem;
      align-items: flex-start;
    }

    .hero-text {
      text-align: left;
    }

    .profile-image {
      flex: 0 0 400px;
    }
  }

  .profile-image {
    border-radius: 1rem;
    object-fit: cover;
    margin: 0 auto 2rem;
    max-width: 100%;
    height: auto;
    box-shadow: var(--shadow-lg);
  }

  h1 {
    font-size: 3rem;
    font-weight: 800;
    color: var(--accent);
    margin: 0.5rem 0;
    letter-spacing: -0.025em;
  }

  .nav-cards {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .nav-card {
    background: var(--background-body);
    padding: 2rem;
    border-radius: 1rem;
    border: 1px solid var(--border);
    box-shadow: var(--shadow-sm);
    text-decoration: none;
    position: relative;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .nav-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-lg);
    border-color: var(--accent-light);
  }

  .nav-card h2 {
    color: var(--accent);
    margin: 0 0 0.75rem 0;
    font-size: 1.5rem;
    font-weight: 700;
  }

  .nav-card p {
    color: var(--text);
    margin: 0;
    line-height: 1.6;
  }

  .card-arrow {
    float: right;
    font-size: 1.5rem;
    color: var(--accent);
    transition: transform 0.3s ease;
  }

  .nav-card:hover .card-arrow {
    transform: translateX(4px);
  }

  .blog-preview {
    margin-top: 4rem;
  }

  .blog-preview h2 {
    font-size: 2rem;
    font-weight: 700;
    color: var(--text);
    margin-bottom: 2rem;
  }

  .post-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.5rem;
  }

  .post-card {
    background: var(--background-body);
    padding: 2rem;
    border-radius: 1rem;
    border: 1px solid var(--border);
    box-shadow: var(--shadow-sm);
    text-decoration: none;
    display: block;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .post-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-lg);
    border-color: var(--accent-light);
  }

  .post-card article {
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  .post-card h3 {
    margin: 0 0 0.75rem 0;
    color: var(--accent);
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.4;
  }

  .post-card p {
    margin: 0;
    color: var(--text-light);
    flex-grow: 1;
    line-height: 1.6;
  }

  .read-more {
    color: var(--accent);
    text-decoration: none;
    font-weight: 600;
    margin-top: 1rem;
    display: inline-block;
    transition: transform 0.2s ease;
  }

  .post-card:hover .read-more {
    transform: translateX(4px);
  }
</style>
